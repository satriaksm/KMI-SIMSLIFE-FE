# ========= App =========
VITE_APP_NAME="SUMILIR"
VITE_APP_URL=http://localhost:5173
VITE_PUBLIC_BASE_PATH=/            # base path SPA (untuk router & build Vite)

# ========= API + Sanctum =========
VITE_API_BASE_URL=http://localhost:8000
VITE_API_PREFIX=/api
VITE_SANCTUM_ENDPOINT=/sanctum/csrf-cookie
VITE_WITH_CREDENTIALS=true         # kirim cookie (HttpOnly) ke backend
VITE_HTTP_TIMEOUT_MS=20000         # timeout axios

# ========= Echo (chat & notifikasi) =========
# Driver umum: pusher (bisa Pusher cloud atau laravel-websockets)
VITE_ECHO_DRIVER=pusher

# Endpoint auth private/presence channel (laravel default)
VITE_ECHO_AUTH_ENDPOINT=/broadcasting/auth
VITE_ECHO_WITH_CREDENTIALS=true    # penting untuk Sanctum
VITE_ECHO_NAMESPACE=App.Events     # opsional, sesuai event namespace di Laravel

# Reverb (local)
VITE_REVERB_APP_KEY=local
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Pusher / Laravel WebSockets (dev, non-TLS)
VITE_PUSHER_APP_KEY=local
VITE_PUSHER_CLUSTER=mt1
VITE_PUSHER_HOST=localhost
VITE_PUSHER_PORT=6001
VITE_PUSHER_WSS_PORT=443
VITE_PUSHER_SCHEME=http
VITE_PUSHER_FORCE_TLS=false
VITE_PUSHER_DISABLE_STATS=true
VITE_PUSHER_WS_ENABLED=true

# ========= Map (Leaflet + OSM) =========
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
VITE_MAP_MAX_ZOOM=19
# Jika pakai provider lain (opsional)
# VITE_MAPBOX_TOKEN=
# VITE_MAP_STYLE_URL=

# ========= Feature flags (opsional) =========
VITE_FEATURE_ECHO=true